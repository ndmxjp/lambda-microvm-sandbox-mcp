{
  "name": "lambda-microvm-sandbox-mcp",
  "version": "0.2.1",
  "description": "MCP server that gives AI coding agents isolated sandboxes on AWS Lambda MicroVMs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws",
    "lambda",
    "microvm",
    "firecracker",
    "sandbox",
    "ai-agent",
    "claude-code",
    "kiro"
  ],
  "license": "MIT",
  "author": "Takumi Saito",
  "homepage": "https://github.com/ndmxjp/lambda-microvm-sandbox-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndmxjp/lambda-microvm-sandbox-mcp.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/ndmxjp/lambda-microvm-sandbox-mcp/issues"
  },
  "type": "module",
  "bin": {
    "lambda-microvm-sandbox-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "image",
    "cloudformation",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-image.mjs && chmod +x dist/index.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1141.0",
    "@aws-sdk/client-iam": "^3.1141.0",
    "@aws-sdk/client-lambda-microvms": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-sts": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@lambda-microvm-sandbox/agent": "*"
  }
}
