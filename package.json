{
  "name": "lambda-microvm-sandbox-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w packages/sandbox-agent && npm run build -w packages/mcp-server",
    "typecheck": "tsc -p packages/sandbox-agent && tsc -p packages/mcp-server --noEmit && tsc -p scripts --noEmit",
    "test": "npm run build && npm run typecheck && vitest run",
    "test:watch": "vitest",
    "build-image": "node packages/mcp-server/dist/index.js setup",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "doctor": "node packages/mcp-server/dist/index.js doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1141.0",
    "@aws-sdk/client-sts": "^3.1141.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
